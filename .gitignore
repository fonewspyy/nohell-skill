# ทะเบียนวงจริง (เก็บเฉพาะ .example.yaml ไว้ใน repo นี้)
CONSOLIDATIONS.yaml

# เศษจาก sandbox/agent
mnt/
/tmp/

# ระบบปฏิบัติการและ editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ของที่ py_compile ทิ้งไว้ตอนรันเทส
__pycache__/
*.pyc

# ผลรอบระหว่างทางของ eval — ไม่ใช่ตัวส่งมอบ
# `*` ครอบธนาคารของทุกแขน (.rounds-routed.json ฯลฯ) — แขนใหม่ต้องไม่หลุดเข้า repo เอง
eval/.rounds*.json

# เวลาต่อ call ของแต่ละแขน — เป็น **ข้อมูลดิบที่ผูกกับเครื่องและช่วงเวลา**
# ตัวเลข latency ที่ไม่มีเงื่อนไขการวัดกำกับคือตัวเลขประเภทเดียวกับ
# "prompt caching ลด latency 85%" ที่ docs/research §10 พิสูจน์ว่าอ้างไม่ได้
# ⇒ เก็บดิบไว้ในเครื่อง ส่วนที่เข้า repo ต้องเป็น *บทสรุปที่ระบุเงื่อนไขการวัด*
eval/.timing-*.json
